# 1. Datos masivos y binarios (Custodiados en Hugging Face Datasets)
Dataset/
*.xlsx
*.parquet

# 2. Archivos temporales y Landing de presentación estática
landing/
__pycache__/
*.py[cod]
*$py.class
*.log
scratch/
.pytest_cache/
.ipynb_checkpoints/

# 3. Entornos virtuales de Python
venv/
.venv/
env/
ENV/

# 4. Configuraciones de entorno de desarrollo (IDEs)
.vscode/
.idea/
*.swp
*.swo

# 5. Configuración y caché de agentes / LLM
.system_generated/
.gemini/
